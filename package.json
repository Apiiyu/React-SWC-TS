{
  "name": "react-swc-ddd-ts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "analyze": "ANALYZE=true bun run build",
    "size": "node scripts/check-bundle-size.mjs",
    "generate:module": "node module.js",
    "dep:check": "depcruise src --config .dependency-cruiser.mjs",
    "dep:graph": "depcruise src --config .dependency-cruiser.mjs --output-type mermaid --output-to docs/architecture-graph.mmd",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview",
    "start:dev": "node check-and-start.js",
    "test": "vitest run --project unit",
    "test:unit": "vitest run --project unit",
    "test:coverage": "vitest run --project unit --coverage",
    "test:storybook": "vitest run --project storybook",
    "test:watch": "vitest --project unit",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "changeset publish"
  },
  "dependencies": {
