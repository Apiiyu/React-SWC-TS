{
  "Zod schema (module)": {
    "scope": "typescript",
    "prefix": "ddd-schema",
    "body": [
      "// Zod",
      "import { z } from \"zod\";",
      "",
      "export const ${1:name}Schema = z.object({",
      "  $2",
      "});",
      "",
      "export type ${1/(.*)/${1:/capitalize}/}Schema = z.infer<typeof ${1:name}Schema>;",
      "",
    ],
    "description": "Zod schema + inferred type, matching src/modules/authentication/schemas",
  },
  "TanStack Query mutation hook (module service)": {
    "scope": "typescriptreact",
    "prefix": "ddd-mutation-hook",
    "body": [
      "// TanStack Query",
      "import { useMutation } from \"@tanstack/react-query\";",
      "",
      "// Plugins",
      "import httpClient from \"@/plugins/axios/axios\";",
      "",
      "export const use${1:Name} = () => {",
      "  return useMutation({",
      "    mutationFn: async (payload: ${2:PayloadType}) => {",
      "      const { data } = await httpClient.post(\"${3:/endpoint}\", payload);",
      "      return data;",
      "    },",
      "  });",
      "};",
      "",
    ],
    "description": "Module service hook wrapping a TanStack Query mutation, matching useAuthenticationLogin.hook.tsx",
  },
  "Zustand store": {
    "scope": "typescript",
    "prefix": "ddd-store",
    "body": [
      "// Zustand",
      "import { create } from \"zustand\";",
      "",
      "interface I${1:Name}Store {",
      "  $2",
      "}",
      "",
      "export const use${1:Name}Store = create<I${1:Name}Store>()((set) => ({",
      "  $3",
      "}));",
      "",
    ],
    "description": "Non-persisted Zustand store, matching app/store conventions",
  },
}
